! return;
! Generate knob for  on_xip1b1
add2expr,var=acbch5.r1b1,expr=on_xip1b1_acbch5.r1b1*on_xip1b1;
add2expr,var=acbyhs4.r1b1,expr=on_xip1b1_acbyhs4.r1b1*on_xip1b1;
