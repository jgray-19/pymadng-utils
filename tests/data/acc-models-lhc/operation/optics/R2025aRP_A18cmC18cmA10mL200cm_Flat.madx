vary, name=on_xip1b1_acbch6.l1b1,step=1.e-12;
vary, name=on_xip1b1_acbyh4.l1b1,step=1.e-12;
on_xip1b1_acbch5.r1b1=1e-10;
jacobian, calls = 10, tolerance=1.e-30,bisec=5;
endmatch;
on_xip1b1=0;
tar_on_xip1b1=tar;
! End generate knob for on_xip1b1
